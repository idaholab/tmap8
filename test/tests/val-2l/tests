[Tests]
  design = 'MatNeumannBC.md CoefCoupledTimeDerivative.md TimeDerivativeNodalKernel.md TrappingNodalKernel.md ReleasingNodalKernel.md'
  issues = '#405'
  validation = 'val-2l.md'
  [val-2l_csvdiff]
    type = CSVDiff
    input = 'val-2l.i'
    cli_args = "nx_scale=5 dt_max='${units 300 s}' dt_min='${units 20 s}' dt_fine_temp='${units 300 s}'
                dt_fine_spectra='${units 30 s}' flux_threshold='${units 1e17 at/m^2/s -> at/mum^2/s}'
                Outputs/file_base=val-2l_light_out
                VectorPostprocessors/mobile_profile/outputs=none
                VectorPostprocessors/trapped_1_profile/outputs=none"
    csvdiff = 'val-2l_light_out.csv'
    override_columns = 'deuterium_mass_conservation_residual'
    override_abs_zero = '1e-1'
    override_rel_err = '2e-5'
    requirement = 'The system shall be able to model deuterium transport through tungsten for comparison with experimental results, using a coarser mesh and larger time steps to limit the computational cost of the test.'
  []
  [val-2l_heavy_csvdiff]
    type = CSVDiff
    input = 'val-2l.i'
    csvdiff = 'val-2l_out.csv'
    override_columns = 'deuterium_mass_conservation_residual'
    override_abs_zero = '1e-1'
    override_rel_err = '2e-5'
    heavy = true
    requirement = 'The system shall be able to model deuterium transport through tungsten for comparison with experimental results, using the fine mesh and small time steps required for validation.'
  []
  [val-2l_animation_csvdiff]
    type = CSVDiff
    input = 'val-2l.i'
    prereq = val-2l_heavy_csvdiff
    should_execute = False
    ignore_columns = 'id'
    heavy = true
    csvdiff = 'deuterium_mobile_concentration_profile/val-2l_out_mobile_profile_0001.csv
               deuterium_mobile_concentration_profile/val-2l_out_mobile_profile_0031.csv
               deuterium_mobile_concentration_profile/val-2l_out_mobile_profile_0061.csv
               deuterium_mobile_concentration_profile/val-2l_out_mobile_profile_0091.csv
               deuterium_mobile_concentration_profile/val-2l_out_mobile_profile_0112.csv
               deuterium_trapped_concentration_profile/val-2l_out_trapped_1_profile_0001.csv
               deuterium_trapped_concentration_profile/val-2l_out_trapped_1_profile_0031.csv
               deuterium_trapped_concentration_profile/val-2l_out_trapped_1_profile_0061.csv
               deuterium_trapped_concentration_profile/val-2l_out_trapped_1_profile_0091.csv
               deuterium_trapped_concentration_profile/val-2l_out_trapped_1_profile_0112.csv'
    requirement = 'The system shall be able to model deuterium transport through tungsten for comparison with experimental results, using the fine mesh and small time steps required for validation, and generate the mobile and trapped concentration profiles.'
  []
  [val-2l_comparison]
    type = RunCommand
    command = 'python3 comparison_val-2l.py'
    requirement = 'The system shall be able to generate comparison plots between the experimental data, TMAP7 results, and simulated solution of validation case 2l.'
    required_python_packages = 'matplotlib numpy pandas'
  []
  [val-2l_profile_animation]
    type = RunCommand
    command = 'python3 trapped_profile_animation_val-2l.py'
    heavy = true
    requirement = 'The system shall be able to generate an animation of the mobile and trapped deuterium concentration profiles for a single trap during validation case 2l.'
    required_python_packages = 'matplotlib numpy pandas PIL'
  []
[]
