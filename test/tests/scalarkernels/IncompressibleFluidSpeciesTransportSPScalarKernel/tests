[Tests]
  design = 'ADIncompressibleFluidSpeciesTransportSPScalarKernel.md'
  issues = '#467'
  [ADbasic_solvent]
    type = CSVDiff
    input = ADsolvent.i
    csvdiff = ADsolvent_out.csv
    requirement = 'The AD kernel must reproduce an analytical expression for transport to a solvent within 1%'
  []
  [ADbasic_metal]
    type = CSVDiff
    input = ADmetal.i
    csvdiff = ADmetal_out.csv
    requirement = 'The AD kernel must reproduce an analytical expression for transport to a liquid metal within 1%'
  []
  [ADbasic_gas]
    type = CSVDiff
    input = ADgas.i
    csvdiff = ADgas_out.csv
    requirement = 'The AD kernel must reproduce an analytical expression for transport to a gas within 1%'
  []
  [ADdecay_solvent]
    type = CSVDiff
    input = ADsolvent_decay.i
    csvdiff = ADsolvent_decay_out.csv
    cli_args = 'primary_half_life=100'
    requirement = 'The AD kernel must reproduce an analytical expression for transport to a solvent with primary species decay within 1%'
  []
  [ADdecay_metal]
    type = CSVDiff
    input = ADmetal_decay.i
    csvdiff = ADmetal_decay_out.csv
    cli_args = 'primary_half_life=100'
    requirement = 'The AD kernel must reproduce an analytical expression for transport to a liquid metal with primary species decay within 1%'
  []
  [ADdecay_gas]
    type = CSVDiff
    input = ADgas_decay.i
    csvdiff = ADgas_decay_out.csv
    cli_args = 'primary_half_life=100'
    requirement = 'The AD kernel must reproduce an analytical expression for transport to a gas with primary species decay within 1%'
  []
  [ADprecursor_solvent]
    type = CSVDiff
    input = ADsolvent_precursor.i
    csvdiff = ADsolvent_precursor_out.csv
    cli_args = 'precursor_concentration_inlet=0.01 precursor_half_life=100'
    requirement = 'The AD kernel must reproduce an analytical expression for transport to a solvent with precursor species decay within 1%'
  []
  [ADprecursor_metal]
    type = CSVDiff
    input = ADmetal_precursor.i
    csvdiff = ADmetal_precursor_out.csv
    cli_args = 'precursor_concentration_inlet=0.01 precursor_half_life=100'
    requirement = 'The AD kernel must reproduce an analytical expression for transport to a liquid metal with precursor species decay within 1%'
  []
  [ADprecursor_gas]
    type = CSVDiff
    input = ADgas_precursor.i
    csvdiff = ADgas_precursor_out.csv
    cli_args = 'precursor_concentration_inlet=0.01 precursor_half_life=100'
    requirement = 'The AD kernel must reproduce an analytical expression for transport to a gas with precursor species decay within 1%'
  []
  [ADtwospecs_solvent]
    type = CSVDiff
    input = ADsolvent_twospecs.i
    csvdiff = ADsolvent_twospecs_out.csv
    requirement = 'The AD kernel must reproduce an analytical expression for transport of a heteronuclear molecule to a solvent within 1%'
  []
  [ADtwospecs_gas]
    type = CSVDiff
    input = ADgas_twospecs.i
    csvdiff = ADgas_twospecs_out.csv
    requirement = 'The AD kernel must reproduce an analytical expression for transport of a heteronuclear molecule to a gas within 1%'
  []
[]
