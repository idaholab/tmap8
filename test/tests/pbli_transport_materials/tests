  [pbli_density_ad_jacobian]
    type = PetscJacobianTester
    input = pbli_ad_property_base.i
    # The density residual is large (about 7e3) compared with its derivative (about 1), so the
    # finite-difference roundoff exceeds 1e-6. The analytic derivative is checked in the unit tests.
    ratio_tol = 1e-5
    cli_args = 'Materials/pbli_property/type=DensityPbLi
                Materials/pbli_property/model=LinearExpansion
                Variables/temperature/initial_condition=700'
    requirement = 'The system shall propagate automatic-differentiation derivatives for the LinearExpansion PbLi density material property.'
  []

