  [pbli_diffusivity_ad_jacobian]
    type = PetscJacobianTester
    input = pbli_ad_property_base.i
    ratio_tol = 1e-6
    cli_args = 'Materials/pbli_property/type=TritiumDiffusivityPbLi
                Materials/pbli_property/model=Terai1992
                Variables/temperature/initial_condition=700'
    requirement = 'The system shall propagate automatic-differentiation derivatives for the Terai1992 PbLi hydrogen isotope diffusivity material property.'
  []

  [pbli_solubility_ad_jacobian]
    type = PetscJacobianTester
    input = pbli_ad_property_base.i
    # The solubility is of order 1e20-1e23 atoms m^-3 Pa^-1/2, so finite-difference roundoff exceeds
    # 1e-6. The analytic derivative is checked to 1e-12 in the unit tests.
    ratio_tol = 1e-5
    cli_args = 'Materials/pbli_property/type=TritiumSolubilityPbLi
                Materials/pbli_property/fp=pbli_fp
                Materials/pbli_property/model=Reiter1991Tritium
                Variables/temperature/initial_condition=700'
    requirement = 'The system shall propagate automatic-differentiation derivatives for the Reiter1991Tritium PbLi hydrogen isotope solubility material property.'
  []

