    input = pbli_three_point_property_base.i
    cli_args = 'Materials/pbli_property/type=DensityPbLi
                Materials/pbli_property/model=LinearExpansion
                AuxKernels/temperature_1/value=600
                AuxKernels/temperature_2/value=700
                AuxKernels/temperature_3/value=800
                Outputs/file_base=pbli_density_linearexpansion_out'
